# ---------------------------------------------------------------------------
# homecarenursing.ca
# ---------------------------------------------------------------------------

# Never serve enquiry logs or the private folder, whatever else is configured.
<FilesMatch "(^enquiries\.log\.php$|\.(log|bak|sql|ini)$)">
  Require all denied
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
RedirectMatch 404 ^/private(/.*)?$

# Canonical host: send everything to www, but KEEP THE VISITOR'S SCHEME.
# https is deliberately NOT forced here yet. homecarenursing.ca has no TLS
# certificate of its own - it is currently served *.allnursing.ca, which does
# not cover this name - so forcing https would put a full-page browser security
# warning in front of every visitor. Once AutoSSL has issued a certificate for
# homecarenursing.ca and www.homecarenursing.ca, replace the two blocks below
# with a plain force-to-https rule.
RewriteEngine On
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteCond %{HTTPS} =on
RewriteRule ^(.*)$ https://www.homecarenursing.ca/$1 [R=301,L]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ http://www.homecarenursing.ca/$1 [R=301,L]

# Light caching for static assets.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css            "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png           "access plus 30 days"
  ExpiresByType image/jpeg          "access plus 30 days"
</IfModule>
