# ---------------------------------------------------------------------------
# homecarenursing.ca
# ---------------------------------------------------------------------------

# Never serve enquiry logs or the private folder, whatever else is configured.
<FilesMatch "(^enquiries\.log\.php$|\.(log|bak|sql|ini)$)">
  Require all denied
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
RedirectMatch 404 ^/private(/.*)?$

# Canonical host: force https and www, so Google is given one address only.
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://www.homecarenursing.ca/$1 [R=301,L]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.homecarenursing.ca/$1 [R=301,L]

# Light caching for static assets.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css            "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png           "access plus 30 days"
  ExpiresByType image/jpeg          "access plus 30 days"
</IfModule>
